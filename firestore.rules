rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // 讀取當前使用者的 Firestore 資料（用於檢查其他文件的權限）
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveEmployee() {
      return isSignedIn() && getUser().status == '在職';
    }

    function isManager() {
      return isActiveEmployee() && getUser().permission in ['admin', 'owner', 'manager'];
    }

    function isOwner() {
      return isActiveEmployee() && getUser().permission in ['admin', 'owner'];
    }

    function isAdmin() {
      return isActiveEmployee() && getUser().permission == 'admin';
    }

    // ===== 使用者資料 =====
    match /users/{uid} {
      // 自己的資料：直接用 UID 比對，不需要 get() 避免自我循環
      allow read: if isSignedIn() && request.auth.uid == uid;
      // 管理層可以讀所有人的資料
      allow read: if isManager();
      // 管理層可以建立員工資料
      allow create: if isManager();
      // 管理層可以修改；本人只能改 googleLinked 欄位
      allow update: if isManager()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['googleLinked']));
      allow delete: if isAdmin();
    }

    // ===== 系統設定 =====
    match /settings/{doc} {
      allow read:  if isActiveEmployee();
      allow write: if isManager();
    }

    // ===== 門市資料（班表、薪資等）=====
    match /stores/{store}/{document=**} {
      // 同門市員工可讀；管理層可讀所有門市
      allow read:  if isActiveEmployee() && (isManager() || getUser().store == store);
      // 同門市管理層可寫
      allow write: if isManager() && getUser().store == store;
    }

    // ===== 待辦事項 =====
    match /todos/{id} {
      allow read:  if isActiveEmployee();
      allow write: if isManager();
    }
    match /todoChecks/{id} {
      allow read:  if isActiveEmployee();
      // 只能寫自己的 check（格式：todoId_uid）
      allow write: if isActiveEmployee()
        && id.matches('.*_' + request.auth.uid);
    }

    // ===== 假期資料 =====
    match /users/{uid}/leaveBalance/{doc} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isManager());
      allow write: if isManager();
    }
    match /users/{uid}/leaveTransactions/{txId} {
      allow read:  if isSignedIn() && (request.auth.uid == uid || isManager());
      allow write: if isManager();
    }
  }
}
